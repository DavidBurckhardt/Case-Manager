# ─────────────────────────────────────────────
# App
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Generador de Expedientes"

# ─────────────────────────────────────────────
# Supabase — Development
# Copy these values from your Supabase Dev project dashboard:
# Settings → API
# ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<dev-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<dev-anon-key>

# Server-side only — NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY=<dev-service-role-key>

# Document upload limits (server-side)
MAX_DOCUMENT_SIZE_MB=25
NEXT_PUBLIC_MAX_DOCUMENT_SIZE_MB=25

# Storage provider ('supabase' | 's3' | 'r2' | 'azure' | 'gcs' | 'minio')
STORAGE_PROVIDER=supabase

# ─────────────────────────────────────────────
# Supabase — Production (used in .env.production only)
# ─────────────────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=https://<prod-project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<prod-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<prod-service-role-key>

# Set to true to log per-page OCR timing and full extracted text (verbose)
OCR_DEBUG=false
