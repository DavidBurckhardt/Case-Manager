# ── API service ──────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed browser origins (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>            # used only to validate incoming user JWTs
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-side data + storage access
SUPABASE_STORAGE_BUCKET=documents

# ── Messaging ────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── LLM ──────────────────────────────────────────────────────
OPENAI_API_KEY=<openai-key>
OPENAI_MODEL=gpt-4o-mini

# ── Limits ───────────────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=25
SIGNED_URL_EXPIRY_SECONDS=3600
