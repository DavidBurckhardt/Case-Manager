# ── API service ──────────────────────────────────────────────
PORT=3001
# Comma-separated list of allowed browser origins (the Next.js frontend)
CORS_ORIGIN=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>            # used only to validate incoming user JWTs
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>   # server-side data + storage access
SUPABASE_STORAGE_BUCKET=documents

# ── Messaging ────────────────────────────────────────────────
NATS_URL=nats://nats:4222

# ── LLM ──────────────────────────────────────────────────────
# Documents are sent as raw PDFs/images to the model (no OCR step), so this
# must be a model that accepts file/vision input via the Responses API.
OPENAI_API_KEY=<openai-key>
OPENAI_MODEL=gpt-5.6-luna

# ── Email — alertas de plazos ────────────────────────────────
# El cron de alertas (8am L-V) manda mail en T-5 y T-2 días hábiles.
# Sin estas variables el cron corre igual pero saltea el envío (loggea warning).
RESEND_API_KEY=re_<resend-key>
RESEND_FROM_EMAIL=plazos@<tu-dominio>
# Base URL del frontend — usada para los links "Ver expediente" en los mails
APP_URL=http://localhost:3000

# ── Limits ───────────────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=25
